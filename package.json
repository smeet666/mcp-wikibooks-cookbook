{
  "name": "mcp-wikibooks-cookbook",
  "version": "1.3.0",
  "description": "MCP server for the Wikibooks Cookbook. Search recipes, read ingredients and steps, and rescale quantities without ending up with 2.4 eggs. No API key required.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wikibooks",
    "cookbook",
    "recipes",
    "cooking",
    "wikimedia",
    "ingredient-scaling"
  ],
  "homepage": "https://github.com/smeet666/mcp-wikibooks-cookbook#readme",
  "bugs": {
    "url": "https://github.com/smeet666/mcp-wikibooks-cookbook/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/smeet666"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smeet666/mcp-wikibooks-cookbook.git"
  },
  "license": "MIT",
  "author": "Damien Bouissou",
  "type": "module",
  "bin": {
    "mcp-wikibooks-cookbook": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": {
      "types": "./dist/wikibooks/client.d.ts",
      "import": "./dist/wikibooks/client.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "mcpName": "io.github.smeet666/mcp-wikibooks-cookbook",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run test/unit",
    "test:live": "vitest run test/live --testTimeout=90000",
    "build:fixtures": "node scripts/build-fixtures.mjs",
    "format": "prettier --write .",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "start": "node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
